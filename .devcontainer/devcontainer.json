{
  "name": "Ralph for Claude Code Development",
  "image": "mcr.microsoft.com/devcontainers/javascript-node:20-bookworm",

  "features": {
    "ghcr.io/devcontainers/features/common-utils:2": {
      "installZsh": true,
      "installOhMyZsh": true,
      "upgradePackages": true,
      "username": "vscode",
      "userUid": "1000",
      "userGid": "1000"
    },
    "ghcr.io/devcontainers/features/git:1": {
      "version": "latest",
      "ppa": false
    }
  },

  "customizations": {
    "vscode": {
      "extensions": [
        "mads-hartmann.bash-ide-vscode",
        "timonwong.shellcheck",
        "foxundermoon.shell-format",
        "rogalmic.bash-debug",
        "jetmartin.bats"
      ],
      "settings": {
        "terminal.integrated.defaultProfile.linux": "bash",
        "terminal.integrated.profiles.linux": {
          "bash": {
            "path": "/bin/bash",
            "icon": "terminal-bash"
          }
        }
      }
    }
  },

  "postCreateCommand": "bash .devcontainer/post-create.sh",

  "remoteUser": "vscode",

  "runArgs": [
    "--cap-add=SYS_PTRACE",
    "--security-opt",
    "seccomp=unconfined"
  ],

  "mounts": [
    "source=${localWorkspaceFolder}/.devcontainer-home,target=/home/vscode,type=bind,consistency=cached"
  ],

  "forwardPorts": [],

  "portsAttributes": {},

  "updateContentCommand": "",

  "postAttachCommand": ""
}
